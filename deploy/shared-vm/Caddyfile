# Port 8081 on the shared VM: a chooser between the old app (jouleWise, compose project
# fdre-dashboard) and the new one (TenderOS). The choice is a cookie, so both apps keep their
# root paths and the address stays the same:
#   /                 the chooser while no app is chosen, else the chosen app
#   /__switch/old     choose the old app      /__switch/new   choose the new app
#   /__switch         forget the choice and show the chooser again
{
	auto_https off
	admin off
}

:8081 {
	header Vary Cookie

	route {
		handle /__switch/old {
			header Set-Cookie "tenderos_app=old; Path=/; Max-Age=2592000; SameSite=Lax; HttpOnly"
			redir * / 303
		}
		handle /__switch/new {
			header Set-Cookie "tenderos_app=new; Path=/; Max-Age=2592000; SameSite=Lax; HttpOnly"
			redir * / 303
		}
		handle /__switch* {
			header Set-Cookie "tenderos_app=; Path=/; Max-Age=0"
			header Cache-Control no-store
			root * /srv/chooser
			rewrite * /index.html
			file_server
		}

		@old header_regexp app Cookie (^|;\s*)tenderos_app=old(;|$)
		handle @old {
			reverse_proxy fdre-dashboard-web-1:3000 {
				flush_interval -1
			}
		}
		@new header_regexp app Cookie (^|;\s*)tenderos_app=new(;|$)
		handle @new {
			reverse_proxy tenderos-web-1:3000 {
				flush_interval -1
			}
		}

		handle /chooser-assets/* {
			root * /srv
			file_server
		}
		handle {
			header Cache-Control no-store
			root * /srv/chooser
			rewrite * /index.html
			file_server
		}
	}
}
