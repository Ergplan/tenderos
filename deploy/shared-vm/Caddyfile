# Port 8081 on the shared VM: a chooser between the old app (jouleWise, compose project
# fdre-dashboard) and the new one (TenderOS). The choice is a cookie, so both apps keep their
# root paths and the address stays the same:
#   /                 the chooser while no app is chosen, else the chosen app
#   /__switch/old     choose the old app      /__switch/new   choose the new app
#   /__switch         forget the choice and show the chooser again
{
	auto_https off
	admin off
}

:8081 {
	import /etc/caddy/apps.caddy
}
