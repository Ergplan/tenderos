# The shared VM's router with HTTPS (docker-compose.https.yml): the same chooser and apps on
#   https://{$SITE_ADDRESS}   a certificate from Let's Encrypt (ZeroSSL as fallback), renewed by
#                             Caddy; http:// on port 80 redirects to it
#   http://<ip>:8081          as before, unencrypted
# Ports 80 and 443 must be free (on the tariff-order VM they were ekbill's Caddy) and open in the
# firewall, so the certificate can be issued.
{
	admin off
}

:8081 {
	import /etc/caddy/apps.caddy
}

{$SITE_ADDRESS} {
	import /etc/caddy/apps.caddy
}
