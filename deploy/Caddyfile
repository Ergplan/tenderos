# HTTPS in front of the web app. SITE_ADDRESS is the host name: a domain whose A record points
# at the VM, or <ip-with-dashes>.sslip.io when there is no domain yet. Caddy gets and renews the
# Let's Encrypt certificate itself (ports 80 and 443 must be reachable for that).
{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 100MB
	}
	reverse_proxy web:3000 {
		# sizing streams progress lines; pass them on as they come
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}
